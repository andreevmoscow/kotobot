# Токен от @BotFather — обязателен
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# id группы, в которой боту разрешено работать (можно несколько через запятую).
# Пусто = разрешено везде (режим настройки, не оставляйте так).
ALLOWED_CHAT_IDS=

# Ключ TheCatAPI (https://thecatapi.com/signup). Без него — демо-лимит.
THE_CAT_API_KEY=

# Минимальный интервал между котиками в одном чате, секунды
COOLDOWN_SECONDS=3

# Inline-режим: @bot_kotobot прямо в поле ввода любого чата
INLINE_ENABLED=1

LOG_LEVEL=INFO
DATA_DIR=data

# Подпись «кто заказал котика»: off | name | mention
REQUESTER_MODE=name
